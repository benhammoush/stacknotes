{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(?:assets|providers|fonts|api)(?:/.*)?", "status": 404 },
    { "src": "/.*\\.[^/]+/?", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
